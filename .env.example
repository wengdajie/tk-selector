# 运行环境
PORT=8080
TZ=Asia/Shanghai

# 数据（SQLite + 媒体文件都放在这里，务必挂到 NAS 上持久化）
DATA_DIR=./data
MEDIA_DIR=./data/media

# 拍摄投递目录（NAS 共享文件夹），系统会定时扫描入库
SCAN_DIR=./data/watch
SCAN_MODE=copy          # copy | move | link
SCAN_INTERVAL=300       # 秒，0 = 只手动扫描

# 可选：成员管理口令（留空则内网完全免密）
ACCESS_CODE=

# 首次启动时的管理员名字
ADMIN_NAME=管理员
MAX_UPLOAD_MB=8192
