# 运行环境
PORT=8080
TZ=Asia/Shanghai

# 数据（SQLite + 媒体文件都放在这里，务必挂到 NAS 上持久化）
DATA_DIR=./data
MEDIA_DIR=./data/media

# 拍摄投递目录（NAS 共享文件夹），系统会定时扫描入库
SCAN_DIR=./data/watch
SCAN_MODE=copy          # copy | move | link
SCAN_INTERVAL=300       # 秒，0 = 只手动扫描

# 可选：成员管理口令（留空则内网完全免密）
ACCESS_CODE=

# 首次启动时的管理员名字
ADMIN_NAME=管理员
MAX_UPLOAD_MB=8192

# ---- AI 脚本拆解（OpenAI 兼容中转站，默认 grsai）----
# 这里只是「出厂默认」；部署后管理员在网页「系统设置」里改的值优先、立即生效
# 在 https://grsai.com/ 拿到 API Key；也可以部署后在界面里填，不用动这个文件
AI_ENABLED=1
AI_BASE_URL=https://api.grsai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o
AI_FRAMES=6            # 每条视频抽几张关键帧（3-10）
AI_TIMEOUT_MS=300000        # 单次拆解超时（毫秒）；慢模型可调大，界面里也能改
PROXY_ENABLED=1             # 播放版转码（手机原片 HEVC→H.264，播放更流畅）；0 = 关闭

# ---- 群通知（企业微信 / 飞书 / 钉钉 群机器人）----
# 这里只是「出厂默认」；部署后管理员在网页「系统设置」里改的值优先、立即生效
NOTIFY_ENABLED=1
NOTIFY_TYPE=wecom       # wecom | feishu | dingtalk
NOTIFY_URL=             # 群机器人 Webhook 地址
NOTIFY_SECRET=          # 钉钉/飞书「加签」密钥；企业微信机器人留空
NOTIFY_PUBLIC_BASE=     # 公网访问地址（如 https://tk.example.com）；配了钉钉才发缩略图卡片
NOTIFY_ON_UPLOAD=1      # 素材入库推送
NOTIFY_ON_COMMENT=1     # 新评论推送
